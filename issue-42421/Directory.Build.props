<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NuGetAudit>false</NuGetAudit>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/private-evidence/**;**/evidence/**;**/artifacts-*/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
